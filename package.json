{
  "name": "nigel-frontend",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "mobile",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"cd web && npm run dev\" \"cd mobile && npm run dev\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.0.0"
  }
}
